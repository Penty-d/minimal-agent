# 复制本文件为 .env 并填入你的配置。.env 已在 .gitignore 中，不会提交。

# 必填：LLM API Key（示例为 DeepSeek）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：OpenAI 兼容协议的 base_url 与模型名，默认 DeepSeek
# 切换到其他服务商只需修改这两行：
#   智谱 GLM : LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4     LLM_MODEL=glm-4-flash
#   通义 Qwen: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   豆包 Ark : LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  LLM_MODEL=<推理接入点id>
#   OpenAI   : LLM_BASE_URL=https://api.openai.com/v1                LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# 思考模式默认开启（响应带 reasoning_content），可用 reasoning_effort 调整：
# LLM_REASONING_EFFORT=high   # low / high / max，默认 high

# 可选：上下文与循环控制
# 模型支持 1M 上下文（上限而非目标），128K 作为单次请求预算
MAX_CONTEXT_TOKENS=128000
MAX_LOOP_TURNS=8
# 官网推荐 temperature=1.0（思考模式下该参数不生效）
TEMPERATURE=1.0
